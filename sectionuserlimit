javascript:(async () => { const DRY_RUN = false; const DELAY_MS = 200; const ENDPOINT = (courseId, userId) => `/courses/${courseId}/limit_user_grading/${userId}`; const log = (...a) => console.log('[section-limit]', ...a); const courseId = (location.pathname.match(/^\/courses\/(\d+)/) || [])[1]; if (!courseId) { alert('Not on a Canvas course page.'); return; } const csrf = decodeURIComponent( (document.cookie.match(/(?:^|;\s*)_csrf_token=([^;]+)/) || [])[1] || '' ); if (!csrf) { alert('No _csrf_token cookie found. Are you logged in?'); return; } const sleep = (ms) => new Promise((r) => setTimeout(r, ms)); const parse = (t) => JSON.parse(t.replace(/^while\(1\);?/, '')); const getPage = async (url) => { const r = await fetch(url, { credentials: 'same-origin', headers: { Accept: 'application/json' } }); if (!r.ok) throw new Error(`GET ${url} -> ${r.status}`); const link = r.headers.get('Link') || ''; const next = (link.match(/<([^>]+)>;\s*rel="next"/) || [])[1] || null; return { data: parse(await r.text()), next }; }; const getAll = async (url) => { const out = []; while (url) { const { data, next } = await getPage(url); out.push(...data); url = next; } return out; }; const enrollmentsUrl = (extra = '') => `/api/v1/courses/${courseId}/enrollments` + `?type[]=StudentEnrollment&state[]=active&state[]=invited&per_page=100${extra}`; const setLimited = async (userId) => { const r = await fetch(ENDPOINT(courseId, userId), { method: 'POST', credentials: 'same-origin', headers: { 'X-CSRF-Token': csrf, 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' }, body: 'limit=1' }); if (r.status === 403) { const body = await r.text(); if (/rate limit/i.test(body)) { await sleep(4000); return setLimited(userId); } throw new Error(`403 on user ${userId} — permission denied`); } if (!r.ok) throw new Error(`POST for user ${userId} -> ${r.status}`); const out = parse(await r.text()); if (out.limited !== true) throw new Error(`user ${userId}: server returned ${JSON.stringify(out)}`); return true; }; const stillOpen = async (userId) => { const e = await getAll(enrollmentsUrl(`&user_id=${userId}`)); return e.some((x) => x.limit_privileges_to_course_section === false); }; const enrollments = await getAll(enrollmentsUrl()); const targets = [ ...new Map( enrollments .filter((e) => e.limit_privileges_to_course_section === false) .map((e) => [e.user_id, e.user?.sortable_name || `user ${e.user_id}`]) ).entries() ]; const sections = new Set(enrollments.map((e) => e.course_section_id)); log(`${enrollments.length} student enrollments across ${sections.size} section(s)`); console.table(targets.map(([id, name]) => ({ user_id: id, name }))); if (!targets.length) { alert('All students are already section-limited.'); return; } if (sections.size < 2) { log('NOTE: single-section course — the flag will be set but has no visible effect.'); } if (DRY_RUN) { alert(`DRY RUN — ${targets.length} student(s) would be limited. See console. ` + `Set DRY_RUN = false to apply.`); return; } if (!confirm(`Limit ${targets.length} student(s) to their own section(s) in course ${courseId}?`)) return; const [firstId, firstName] = targets[0]; await setLimited(firstId); await sleep(500); if (await stillOpen(firstId)) { alert(`Aborted. The request succeeded but ${firstName}'s flag did not change.\n\n` + `The endpoint has likely moved. Toggle one student manually with DevTools > ` + `Network open and update ENDPOINT to match.`); return; } log(`canary OK — ${firstName} is now section-limited`); const failed = []; for (const [id, name] of targets.slice(1)) { await sleep(DELAY_MS); try { await setLimited(id); log(`ok: ${name}`); } catch (err) { failed.push(name); console.error(`[section-limit] ${name}:`, err); } } await sleep(1000); const after = await getAll(enrollmentsUrl()); const remaining = after.filter((e) => e.limit_privileges_to_course_section === false).length; alert(`Done. ${targets.length - failed.length}/${targets.length} updated.` + (failed.length ? `\nFailed: ${failed.join(', ')}` : '') + `\nUnlimited student enrollments remaining: ${remaining}`); })();
